{
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-lcd",
            "sdkconfig_append": [
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_MAX_LFN=255",
                "CONFIG_FATFS_CODEPAGE=437",

                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
                "CONFIG_LANGUAGE_RO_RO=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_JARVIS_TTS=y",
                "CONFIG_SR_WN_WN9_SOPHIA_TTS=y",
                "CONFIG_LCD_ILI9341_240X320=y",
				"CONFIG_APP_EXCLUDE_PROJECT_NAME_VAR=y",
				"CONFIG_FLASH_CUSTOM_ASSETS=y",
				"CONFIG_CUSTOM_ASSETS_FILE=\"${CMAKE_CURRENT_SOURCE_DIR}/main/boards/${BOARD_TYPE}/my_assets.bin\"",
				"CONFIG_EMOTE_DEF_FONT_COLOR=0xFFFFFF",
				"CONFIG_EMOTE_DEF_BG_COLOR=0x000000"
				
            ]
        }
    ]
}
